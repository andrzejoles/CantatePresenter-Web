# ===================================================================
# CantatePresenter Web — Konfiguracja Środowiska Produkcyjnego (VPS)
# ===================================================================

# Port na którym nasłuchuje aplikacja (domyślnie 3000, za Nginxem)
PORT=3000

# Tryb środowiska: 'production' lub 'development'
NODE_ENV=production

# Tajny klucz do podpisywania sesji i ciasteczek (wygeneruj losowy ciąg min. 32 znaków)
# Przykład generowania w konsoli: openssl rand -hex 32
SESSION_SECRET=tutaj_wpisz_losowy_ciag_znakow_np_openssl_rand_hex_32

# Opcjonalny własny Klucz Konfiguracji Początkowej (Master Setup Key).
# Jeśli pozostawisz to pole puste, serwer przy pierwszym uruchomieniu wygeneruje
# w 100% losowy klucz kryptograficzny i wypisze go w konsoli oraz w data/.bootstrap_key
# MASTER_SETUP_KEY=twoj_bezpieczny_klucz_poczatkowy

# Czy aplikacja działa za reverse proxy Nginx (ustaw 'true' na VPS)
TRUST_PROXY=true

# Czas wygaśnięcia sesji logowania w godzinach (domyślnie 24h)
SESSION_EXPIRE_HOURS=24
